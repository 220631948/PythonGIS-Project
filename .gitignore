# =============================================================================
# Cape Town GeoHub — .gitignore
# Purpose: keep repository clean while preserving source, configs, and fixtures.
# =============================================================================

# -----------------------------------------------------------------------------
# Python / FastAPI artifacts
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# Virtual environments (local-only)
.venv/
.venv*/
venv/
ENV/
env/
.audit-venv/

# Python tooling caches
.pytest_cache/
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.dmypy.json
dmypy.json
.ipynb_checkpoints/

# Coverage / reports
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Build / packaging outputs
build/
dist/
site/
*.egg-info/
*.egg
*.manifest
*.spec
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Node / React (Vite + TypeScript) artifacts
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js

# Package manager caches (machine-specific)
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Frontend build + tool caches
.vite/
frontend/.vite/
frontend/dist/
frontend/build/
.cache/
.parcel-cache/
.turbo/
storybook-static/
.eslintcache
frontend/.eslintcache
*.tsbuildinfo

# JS test outputs
coverage/
.nyc_output/
frontend/test-results/
frontend/playwright-report/
frontend/playwright/.cache/
playwright/.cache/
blob-report/

# JS logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Spatial / PostGIS / database artifacts
# -----------------------------------------------------------------------------
postgres_data/
pgdata/
pg_data/
volumes/
docker-data/

# DB dumps and backups
*.sql.gz
*.dump
*.backup
*.bak

# Local sqlite and similar db files
*.db
*.db-shm
*.db-wal
*.sqlite3
*.sqlite3-journal

# Binary geospatial formats (large/derived)
*.parquet
*.feather
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.gpkg
*.mbtiles
*.kml
*.kmz
*.gml
*.tif
*.tiff

# GeoJSON can be very large in this repo; keep targeted fixtures/public assets
*.geojson
!test-fixtures/*.geojson
!frontend/public/*.geojson

# Cache directories (keep repo placeholders)
data/cache/*
!data/cache/.gitkeep
!data/raw/.gitkeep

# -----------------------------------------------------------------------------
# Environment and secrets (critical)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
.envrc

secrets/
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.ssh/
*.asc
*.gpg
config/local.yaml
config/production.yaml
.secrets.baseline

# -----------------------------------------------------------------------------
# IDE / editor / OS clutter
# -----------------------------------------------------------------------------
.vscode/
*.code-workspace
.idea/
*.iml
*.iws
*.ipr

# Editor swap/backup files
*.swp
*.swo
*~
.*.sw[op]
\#*\#
.\#*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
.directory
.Trash-*
.nfs*

# Other editors
.junie/
.helix/
.fleet/
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Docker / runtime / temp artifacts
# -----------------------------------------------------------------------------
docker-compose.override.yml
.dockerignore.local
*.tar

tmp/
temp/
.temp/
*.tmp
*.temp
*.pid
*.pid.lock
*.sock
logs/
*.log
*.log.*

