# Cape Town GeoHub - Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# DATABASE CONFIGURATION (Required — docker compose will FAIL without these)
# =============================================================================
POSTGRES_USER=geohub
POSTGRES_PASSWORD=ferdav123  # ⚠️  REQUIRED: Set a strong password. compose.yaml uses ${POSTGRES_PASSWORD:?err}
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=geohub_db

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Cape Town GeoHub
APP_VERSION=1.1.0
DEBUG=false
API_PREFIX=/api

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# =============================================================================
# SPATIAL CONFIGURATION
# =============================================================================
# Default CRS for web mapping (WGS84)
TARGET_CRS=EPSG:4326
# Projected CRS for accurate distance calculations (UTM Zone 34S for Cape Town)
PROJECTED_CRS=EPSG:32734

# Coordinate simplification tolerance (degrees for EPSG:4326)
SIMPLIFICATION_TOLERANCE=0.0001
COORDINATE_PRECISION=6

# =============================================================================
# CACHE SETTINGS
# =============================================================================
CACHE_DURATION_DAYS=7
MAX_CACHE_SIZE_MB=500

# Redis Configuration (Optional - for production caching)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# API RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# CORS ORIGINS (comma-separated for multiple origins)
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# SENTRY (Optional but recommended in staging/production)
# =============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false

# =============================================================================
# FRONTEND CONFIGURATION (for Docker builds)
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_MAP_CENTER=-33.9249,18.4241
VITE_MAP_ZOOM=12

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# City of Cape Town Open Data Portal - no auth required for public endpoints
# ARCGIS_API_KEY=your_arcgis_key_if_needed

# =============================================================================
# SECURITY (Production only)
# =============================================================================
# SECRET_KEY=your_random_secret_key_for_jwt
# ALLOWED_HOSTS=geohub.capetown.gov.za

# Admin API Key — protects /api/stats, /api/cache/clear, /api/config
# ⚠️  REQUIRED for production. Leave empty ONLY in local dev (endpoints will warn).
ADMIN_API_KEY=
