{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cape-town-geohub.local/schemas/findings-entry.schema.json",
  "title": "Findings Entry Schema",
  "description": "Schema for findings.json entries generated by SUPER-AGENT v3",
  "type": "object",
  "required": ["id", "severity", "summary", "files", "recommendation", "trace_id", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^f-[0-9]{4,}$",
      "description": "Unique finding identifier (e.g., f-0001)"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"],
      "description": "Severity level of the finding"
    },
    "category": {
      "type": "string",
      "enum": ["security", "quality", "performance", "accessibility", "spatial-integrity", "policy-violation", "architecture"],
      "description": "Category of the finding"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Short summary of the finding"
    },
    "detail": {
      "type": "string",
      "description": "Detailed explanation of the finding"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of files affected by this finding"
    },
    "recommendation": {
      "type": "string",
      "description": "Recommended action to resolve the finding"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace-[a-z0-9-]+$",
      "description": "Trace ID linking to execution context"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when finding was detected"
    },
    "source": {
      "type": "string",
      "description": "Source of the finding (skill, hook, or tool)"
    },
    "patch_generated": {
      "type": "boolean",
      "description": "Whether a patch was generated for this finding"
    },
    "patch_path": {
      "type": "string",
      "description": "Path to the generated patch file (relative to repo root)"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "External references or documentation links"
    }
  }
}
