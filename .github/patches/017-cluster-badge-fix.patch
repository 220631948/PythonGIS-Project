+                }}>
+                  {point_count > 999 ? `${(point_count / 1000).toFixed(1)}k` : point_count}
+                </span>
+              </Tooltip>
+            )}

--- Add CSS for cluster tooltip (add to styles or inline) ---
 # In a CSS file or <style> tag:
 .cluster-count-tooltip {
   background: transparent !important;
   border: none !important;
   box-shadow: none !important;
   padding: 0 !important;
 }
 .cluster-count-tooltip::before {
   display: none !important; /* Remove tooltip arrow */
 }
