+import re as _re
+
+# Safe table name pattern: lowercase letters, digits, underscores only
+_SAFE_TABLE_NAME = _re.compile(r'^[a-z][a-z0-9_]{0,62}$')
+
+def _validate_table_name(table_name: str) -> str:
+    """Validate and sanitize table name to prevent SQL injection."""
+    if not _SAFE_TABLE_NAME.match(table_name):
+        raise ValueError(
+            f"Invalid table name: '{table_name}'. "
+            "Only lowercase letters, digits, and underscores allowed."
+        )
+    return table_name


