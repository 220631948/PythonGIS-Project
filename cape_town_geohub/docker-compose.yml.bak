version: '3.8'

services:
  # Database Service (PostGIS)
  db:
    image: postgis/postgis:15-3.3
    container_name: geohub-db
    environment:
      - POSTGRES_DB=geohub
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
    ports:
      - "5432:5432"
    volumes:
      - geohub-db-data:/var/lib/postgresql/data
    networks:
      - geohub-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d geohub"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  # Backend Service (GIS Engine)
  api:
    build: 
      context: .
      dockerfile: Dockerfile
    container_name: geohub-api
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "8000:8000"
    volumes:
      - .:/code  # Host mount for hot reloading
      - ./data:/code/data # Persist data
    environment:
      - PYTHONUNBUFFERED=1
      - DATABASE_URL=postgresql://postgres:postgres@db:5432/geohub
    env_file:
      - .env
    networks:
      - geohub-net
    restart: unless-stopped

  # Frontend Service (UI)
  web:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: geohub-web
    ports:
      - "3000:80"
    depends_on:
      - api
    networks:
      - geohub-net
    restart: unless-stopped

networks:
  geohub-net:
    driver: bridge

volumes:
  geohub-db-data: