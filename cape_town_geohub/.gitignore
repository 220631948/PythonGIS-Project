# Python backend section
# Exclude all pycache directories
__pycache__/
**/__pycache__/
# Exclude all py cod pyc pyo so files
*.py[cod]
*.so
# Exclude all virtual environment folders
venv/
.venv/
ENV/
env/
.Python
# Exclude all pytest cache and coverage files
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
# Exclude all distribution and packaging artifacts
build/
dist/
*.egg-info/
*.wheels/

# Node frontend section
# Exclude all node_modules directories
node_modules/
**/node_modules/
# Exclude pnp files
.pnp
.pnp.js
# Exclude all build outputs
frontend/dist/
frontend/build/
.vite/
*.tsbuildinfo
# Exclude all test coverage directories
coverage/
# Playwright artifacts
frontend/test-results/
frontend/playwright-report/
# ESLint cache
frontend/.eslintcache
# Exclude all log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database and spatial data section
# CRITICAL: postgres_data folder must never be committed
postgres_data/
pgdata/
# Exclude all database files with db extension and related
*.db
*.sqlite3
# Exclude all cached geojson files in data slash cache
data/cache/*
# Exclude all parquet files
*.parquet
# Exclude all shp shx dbf prj cpg shapefile formats
*.shp
*.shx
*.dbf
*.prj
*.cpg
# Keep directory structure by including .gitkeep files
!data/cache/.gitkeep
!data/raw/.gitkeep
# Exclude all geojson files generally but allow test-fixtures
*.geojson
!test-fixtures/*.geojson
!frontend/public/*.geojson

# Environment and secrets section
# Exclude all .env files
.env
.env.local
.env.production
.env.development
.env.*.local
# Exclude secrets folder entirely
secrets/
# Exclude all pem key crt certificate files
*.pem
*.key
*.crt
# Exclude all id_rsa SSH key patterns
id_rsa*
# Exclude override config files
config/local.yaml
config/production.yaml

# IDE and operating system section
# Exclude .vscode folder and code-workspace files
.vscode/
*.code-workspace
# Exclude .idea folder and all iml iws files
.idea/
*.iml
*.iws
# Exclude all vim swap files
*.swp
*.swo
*~
# Exclude macOS system files
.DS_Store
.AppleDouble
.LSOverride
# Exclude Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# Docker and deployment section
volumes/
docker-data/
tmp/
temp/
*.tmp

# Local agent memory
.agent-memory
