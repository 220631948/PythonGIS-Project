# syntax=docker/dockerfile:1

# Cape Town GeoHub - Python GIS Web Application Dockerfile
# This Dockerfile builds a production-ready container for the FastAPI backend

################################################################################
# Build stage - Install dependencies and prepare the application
################################################################################
FROM python:3.11-slim-bookworm as builder

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Copy only requirements first (for layer caching)
COPY cape_town_geohub/requirements.txt .

# Install Python dependencies using granular steps for better caching and timeout handling
RUN pip install --no-cache-dir --upgrade pip --default-timeout=1000
RUN pip install --no-cache-dir --default-timeout=1000 "numpy<2"
RUN pip install --no-cache-dir --default-timeout=1000 "shapely==2.0.2"
RUN pip install --no-cache-dir --default-timeout=1000 "pyproj==3.6.1"
RUN pip install --no-cache-dir --default-timeout=1000 "pandas==2.2.0"
RUN pip install --no-cache-dir --default-timeout=1000 "geopandas==0.14.2"
RUN pip install --no-cache-dir --default-timeout=1000 "psycopg2-binary" "SQLAlchemy>=2.0.0"
RUN pip install --no-cache-dir --default-timeout=1000 "GeoAlchemy2>=0.14.0"
RUN pip install --no-cache-dir --default-timeout=1000 -r requirements.txt

################################################################################
# Final stage - Create minimal production image
################################################################################
FROM python:3.11-slim-bookworm as final

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_HOME=/app

WORKDIR $APP_HOME

# Install only curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create a non-privileged user for security
ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "${UID}" \
    appuser

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY cape_town_geohub/ .

# Create necessary directories and set permissions
RUN mkdir -p data/raw data/processed data/cache logs static \
    && chown -R appuser:appuser $APP_HOME

# Switch to non-privileged user
USER appuser

# Expose the application port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
