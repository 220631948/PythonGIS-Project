# Frontend Environment Variables - Example
# Copy this to .env and configure as needed

# Backend API Base URL
VITE_API_URL=http://localhost:8000

# For production (GitHub Pages), use your deployed backend URL
# VITE_API_URL=https://your-backend-url.com

# Sentry (optional - set in CI or local .env for verification)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_SEND_DEFAULT_PII=false
VITE_SENTRY_SESSION_REPLAY=false
